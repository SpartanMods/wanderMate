# Supabase — copy this file to .env.local and fill in your project values.
# API keys: Supabase Dashboard → Project Settings → API
# DB password: Supabase Dashboard → Project Settings → Database

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Required for `npx supabase db query --remote` and direct Postgres CLI access.
# Not used by the Next.js app itself.
SUPABASE_DB_PASSWORD=your-database-password-here

# Recreation Information Database (RIDB) — recreation.gov public API
# Get a key at https://ridb.recreation.gov/landing (free, instant)
# Used by the live conditions layer to show nearby campgrounds/facilities.
RIDB_API_KEY=your-ridb-api-key-here

# Contact included in the weather.gov User-Agent (NWS requires a reachable
# contact so they can reach the operator before blocking traffic).
# Optional override; defaults to the project inbox (wandermate@gmail.com).
NWS_USER_AGENT_CONTACT=
